# 이 파일을 "application-local.yml" 이라는 이름으로 복사한 뒤, 아래 값을 채운다.
# application-local.yml 은 .gitignore 에 있어 git에 올라가지 않는다. 이 .example 파일만 커밋된다.
#
#   cp application-local.yml.example application-local.yml
#
# 그다음 IntelliJ에서 그냥 QuantlogApplicationKt 를 실행하면 된다. 환경변수(Run Configuration)는 필요 없다.

kis:
  mock:
    app-key: "여기에 모의투자 앱키"
    app-secret: "여기에 모의투자 앱시크릿"
    account: "12345678-01"   # 모의계좌 (뒤 2자리 없으면 "12345678" 만 써도 됨, 기본값 01 적용)
    hts-id: "여기에 KIS Developers 고객(HTS) ID"   # 실시간 체결통보 구독용. 비우면 체결통보 꺼짐
    log-raw: true             # 첫 연동 확인 때는 true 로 응답 원문을 로그로 본다. 익숙해지면 false

quantlog:
  notify:
    webhook-url: ""          # Discord/Slack 웹훅 URL. 체결(매수/매도)과 WARN 이상 로그를 알린다. 비우면 꺼짐
  smoke:
    mode: "READ"              # READ(조회만) / BUY / SELL. 비워두면 아무것도 안 한다.
    market: "KR"
    symbol: "005930"          # 종목코드
    quantity: 1
